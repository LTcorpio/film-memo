{
  "name": "film-memo",
  "version": "1.0.0",
  "private": true,
  "description": "个人观影记录数据展示",
  "type": "module",
  "scripts": {
    "import": "node scripts/import-excel.js",
    "scrape": "node scripts/scrape-metadata.js",
    "server": "node server/index.js",
    "dev": "concurrently -n server,web -c blue,green \"npm:server\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2"
  }
}
