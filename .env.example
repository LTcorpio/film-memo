# TMDB API credentials (https://www.themoviedb.org/settings/api)
# 方式一（推荐）: v4 Read Access Token (Bearer)
TMDB_ACCESS_TOKEN=
# 方式二: v3 API Key
TMDB_API_KEY=

# 服务端口
PORT=4000
# Excel 数据源路径（可选，默认使用 ~/Desktop/影视观看记录.xlsx）
EXCEL_PATH=

# 数据库文件路径（可选，默认使用项目根目录 data/films.db）
DB_PATH=
# 本地图片存储目录（可选，默认使用项目根目录 data/images/）
IMAGES_DIR=

# ===== Docker 部署说明 =====
# 复制本文件为 .env 并填写 TMDB 凭证后，执行：
#   docker compose up -d --build
# docker-compose.yml 会自动读取 .env 中的 TMDB_ACCESS_TOKEN / TMDB_API_KEY 注入容器。
# Docker 模式下端口(8686)、DB_PATH 由 docker-compose.yml 固定，此处 PORT/EXCEL_PATH 不生效。
# 数据库与图片持久化在项目根目录的 docker-data/ 下：
#   docker-data/db/films.db      数据库
#   docker-data/images/          本地图片
# 启动/停止：
#   docker compose up -d          启动（后台）
#   docker compose down           停止并移除容器（数据保留）
